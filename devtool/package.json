{
  "name": "webtool-devtool",
  "version": "0.1.1",
  "description": "Dev-only Vite plugin that overlays modular site-building tools (resize, inspect, typography, colors, ...) and writes changes back to source.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "tools",
    "bin",
    "templates",
    "README.md"
  ],
  "keywords": [
    "vite",
    "vite-plugin",
    "devtools"
  ],
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test",
    "release": "npm version patch --no-git-tag-version && npm publish",
    "prepack": "node scripts/copy-templates.js"
  },
  "dependencies": {
    "postcss": "^8.4.47"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "bin": {
    "webtool-devtool": "./bin/cli.js"
  },
  "types": "./src/index.d.ts",
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
